# Vivitalk Backend Configuration — copy to .env and fill in your real values

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=vivitalk-index

# Supabase (Service Role key required for admin operations)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_API_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# JWT (any random UUID/long random string is fine)
JWT_SECRET_KEY=change-me-to-a-random-uuid
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","*"]
RATE_LIMIT_PER_MINUTE=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# RAG tuning
RAG_SIMILARITY_THRESHOLD=0.15
RAG_TOP_K=5
RAG_HYBRID_ALPHA=0.7
